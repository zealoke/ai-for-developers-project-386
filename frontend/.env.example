# Базовый URL, на который браузер отправляет запросы. Используется рантаймом
# приложения (src/api/client.ts). Для локальной разработки оставляем /api —
# запросы уйдут через dev-прокси Vite (см. vite.config.ts). Для прод-сборки
# указывайте абсолютный адрес бэкенда, например https://api.example.com/v1.
VITE_API_BASE_URL=/api

# Куда Vite-прокси перенаправляет запросы с /api в режиме разработки.
# http://localhost:4010 — Prism mock (npm run mock)
# http://localhost:4011 — Prism proxy к реальному бэкенду (npm run proxy)
# http://localhost:3000 — реальный бэкенд напрямую (без Prism)
DEV_API_TARGET=http://localhost:4010

# Префикс пути, который нужно ДОБАВИТЬ к запросу при проксировании на
# DEV_API_TARGET. Контракт объявляет сервер https://api.example.com/v1, но
# Prism отдаёт пути от корня (без /v1). Поэтому:
#   для Prism (mock/proxy)   -> оставить пустым
#   для реального бэкенда, если он живёт под /v1 -> DEV_API_PREFIX=/v1
DEV_API_PREFIX=
